BASE_URL=https://news.hada.io
USER_AGENT=geeknews-crawl/0.1 (+https://github.com/yoophi/geeknews-crawl)
REQUEST_INTERVAL_MS=1000
VAULT_DIR=./vault

# 인증 (즐겨찾기 동기화 등) — 아래 중 하나 이상 설정
# 1) 로그인 자격증명: 쿠키가 없거나 만료되면 /auth/gn_login으로 자동 로그인
GEEKNEWS_USERID=
GEEKNEWS_PASSWORD=
# 2) 수동 쿠키 헤더 (설정 시 우선 사용)
# COOKIE_HEADER=PHPSESSID=...; remember_me=...
# 3) 쿠키 파일 경로 (Netscape cookies.txt | JSON 객체 | 한 줄 헤더)
COOKIE_FILE=
